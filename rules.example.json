{
  "rules": [
    {
      "name": "高风险邮件只通知",
      "enabled": true,
      "if": {
        "securityRisk": "high"
      },
      "then": {
        "notify": true,
        "autoReply": false,
        "markSeen": true,
        "moveTo": "AI-Risk",
        "notifyChannels": ["default-wecom"]
      }
    },
    {
      "name": "需要人工复核只通知",
      "enabled": true,
      "if": {
        "needsHumanReview": true
      },
      "then": {
        "notify": true,
        "autoReply": false,
        "markSeen": true,
        "notifyChannels": ["default-wecom"]
      }
    },
    {
      "name": "黑名单域名只通知并移动",
      "enabled": true,
      "if": {
        "sourceBlocked": true
      },
      "then": {
        "notify": true,
        "autoReply": false,
        "markSeen": true,
        "moveTo": "AI-Blocked",
        "notifyChannels": ["default-wecom"]
      }
    },
    {
      "name": "白名单域名允许正常处理",
      "enabled": true,
      "if": {
        "sourceTrusted": true
      },
      "then": {
        "notify": true,
        "autoReply": true,
        "markSeen": true,
        "notifyChannels": ["default-wecom"]
      }
    },
    {
      "name": "系统通知不回复",
      "enabled": true,
      "if": {
        "category": "系统通知"
      },
      "then": {
        "notify": true,
        "autoReply": false,
        "markSeen": true,
        "notifyChannels": ["default-wecom"]
      }
    },
    {
      "name": "低风险客户咨询允许自动回复",
      "enabled": true,
      "if": {
        "category": "客户咨询",
        "securityRisk": "low"
      },
      "then": {
        "notify": true,
        "autoReply": true,
        "markSeen": true,
        "notifyChannels": ["default-wecom"]
      }
    }
  ],
  "defaultAction": {
    "notify": true,
    "autoReply": true,
    "markSeen": true,
    "notifyChannels": ["default-wecom"]
  }
}
